# ==========================================================
# yukTakarin! — contoh variabel lingkungan
# Salin menjadi .env lalu isi nilainya. JANGAN commit .env.
#
# Tanpa DATABASE_URL, aplikasi otomatis memakai seed lokal
# (mode demo) sehingga tetap bisa dijalankan dan diuji.
# Tanpa CLOUDINARY_*, unggah foto memakai placeholder SVG.
# Tanpa OWNER_*, login dapur memakai kredensial dev lokal
# (username "pemilik", password "dapur-lokal"). WAJIB diisi
# sebelum dipakai warung sungguhan.
# ==========================================================

# Neon PostgreSQL (connection string pooled / direct)
DATABASE_URL=postgres://endpoint:password@db.freeportneon.neon.tech/neondb

# Contoh lengkap .env.example:
# DATABASE_URL=postgres://admin:password@db.learn.neon.tech/neondb
# CLOUDINARY_CLOUD_NAME=demo
# MIDTRANS_SERVER_KEY=SB-Midserver-...
# dll.

# Cloudinary — Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nomor WhatsApp pemilik warung, format internasional tanpa "+"
PUBLIC_WA_NUMBER=6281234567890

# Login Pemilik Warung (jangan pakai nilai contoh di produksi)
OWNER_USERNAME=pemilik
OWNER_PASSWORD=ganti-password-kuat

# Kunci tanda tangan cookie sesi — acak, minimal 32 karakter
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Midtrans Sandbox — daftar di midtrans.com, ambil di dashboard
# Mode sandbox: gunakan SB- prefix, mode produksi: po- prefix
MIDTRANS_SERVER_KEY=SB-Midserver-XXXXXXXX-XXXXXXXX-XXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Midclient-XXXXXXXX-XXXXXXXX-XXXXXXXX
