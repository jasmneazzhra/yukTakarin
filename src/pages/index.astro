---
import Base from '../layouts/Base.astro';
import { daftarProduk } from '../lib/repo.js';
import { placeholderMenu } from '../lib/placeholder.js';
import { formatRupiah } from '../lib/kitchen.js';

const populer = (await daftarProduk({ publik: true })).slice(0, 3);
---

<Base judul="yukTakarin!" deskripsi="yukTakarin! — Katalog Coffee & Kue Rumahan">
  <script is:inline>document.documentElement.classList.add('js');</script>

  <header class="wrap topbar">
    <p class="wordmark">yukTakarin!</p>
    <a class="btn btn--quiet btn--sm" href="/login">Masuk Pemilik</a>
  </header>

  <main class="wrap beranda">
    <section class="hero">
      <span class="blob blob--1" aria-hidden="true"></span>
      <span class="blob blob--2" aria-hidden="true"></span>
      <span class="blob blob--3" aria-hidden="true"></span>

      <div class="hero__teks">
        <p class="eyebrow anim" style="--i: 0">Katering harian &amp; acara</p>
        <h1 class="anim" style="--i: 1">Kopi, pastry, dan kue rumahan.</h1>
        <p class="sub anim" style="--i: 2">
          Untuk rapat kantor dan acara. Pilih menu, atur jumlah dan jadwal, lalu bayar online.
        </p>
        <div class="aksi anim" style="--i: 3">
          <a href="/menu" class="btn btn--primary denyut">Lihat Katalog →</a>
        </div>
      </div>

      <div class="hero__cangkir anim anim--pop" style="--i: 2" aria-hidden="true">
        <svg viewBox="0 0 240 220" width="100%" height="100%">
          <g class="uap" fill="none" stroke="#1f1b16" stroke-width="5" stroke-linecap="round">
            <path class="uap__1" d="M90 70 C75 55, 105 45, 90 28" />
            <path class="uap__2" d="M125 72 C110 55, 140 42, 125 22" />
            <path class="uap__3" d="M160 70 C145 55, 175 45, 160 30" />
          </g>
          <rect x="50" y="86" width="130" height="100" rx="14" fill="#f6f2e9" stroke="#1f1b16" stroke-width="5" />
          <path d="M180 108h16a24 24 0 0 1 0 48h-16" fill="none" stroke="#1f1b16" stroke-width="5" />
          <circle cx="115" cy="136" r="26" fill="#ffd23f" stroke="#1f1b16" stroke-width="5" />
          <rect x="30" y="196" width="170" height="10" rx="5" fill="#1f1b16" />
        </svg>
      </div>
    </section>

    <section>
      <h2 class="judul reveal">Menu Populer</h2>
      <div class="grid">
        {populer.map((item, i) => {
          const nama = 'nama' in item ? item.nama : 'Menu';
          const kategori = 'kategori' in item ? item.kategori : 'Umum';
          const deskripsi = 'deskripsi' in item ? item.deskripsi : 'Menu pilihan kami.';
          const harga = 'harga' in item ? item.harga : 0;
          const minOrder = 'minOrder' in item ? item.minOrder : 1;
          const satuan = 'satuan' in item ? item.satuan : '';
          const imageUrl = 'imageUrl' in item ? item.imageUrl : '';

          return (
            <article class="card kartu reveal" style={`--i: ${i}`}>
              <div class="kartu__bungkus">
                <img
                  class="kartu__foto"
                  src={imageUrl || placeholderMenu(nama, kategori)}
                  alt={nama}
                  loading="lazy"
                />
              </div>
              <div class="kartu__isi">
                <span class="badge badge--netral">{kategori}</span>
                <h3>{nama}</h3>
                <p class="muted deskripsi">{deskripsi}</p>
                <p class="meta">
                  <strong class="tabular">{formatRupiah(harga)}</strong>
                  <span class="muted">
                    {satuan ? `/${satuan} · ` : ''}min. {minOrder}
                  </span>
                </p>
                <a class="btn btn--quiet btn--sm btn--block" href="/menu">Lihat detail</a>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </main>

  <footer class="wrap footer reveal">
    <p><strong>yukTakarin!</strong> · Coffee &amp; Kue rumahan</p>
    <p class="muted">Buka 07.00–21.00 WIB</p>
  </footer>
</Base>

<script>
  // Munculkan elemen .reveal saat masuk layar.
  const target = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const pengamat = new IntersectionObserver(
      (entri) => {
        for (const e of entri) {
          if (e.isIntersecting) {
            e.target.classList.add('terlihat');
            pengamat.unobserve(e.target);
          }
        }
      },
      { threshold: 0.15 },
    );
    target.forEach((el) => pengamat.observe(el));
  } else {
    target.forEach((el) => el.classList.add('terlihat'));
  }
</script>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 16px;
  }
  .wordmark {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
  }
  .beranda {
    display: grid;
    gap: 48px;
    padding-bottom: 48px;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 24px;
    align-items: center;
    grid-template-columns: 1.3fr 1fr;
    background: var(--mustard);
    border: var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: 40px 32px;
  }
  .hero__teks {
    position: relative;
    z-index: 1;
  }
  .eyebrow {
    display: inline-block;
    background: var(--cream);
    border: var(--border);
    border-radius: 999px;
    padding: 2px 12px;
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
  }
  .hero h1 {
    margin: 0 0 10px;
    font-size: clamp(28px, 5vw, 46px);
    line-height: 1.1;
    font-weight: 800;
  }
  .sub {
    margin: 0 0 22px;
    max-width: 48ch;
  }
  .hero__cangkir {
    position: relative;
    z-index: 1;
    max-width: 280px;
    justify-self: center;
    width: 100%;
    animation: ambang 4s ease-in-out infinite;
  }

  /* bentuk dekoratif melayang */
  .blob {
    position: absolute;
    border: var(--border);
    border-radius: 50%;
    opacity: 0.9;
  }
  .blob--1 { width: 90px; height: 90px; background: var(--coral); top: -30px; right: 22%; animation: melayang 7s ease-in-out infinite; }
  .blob--2 { width: 56px; height: 56px; background: var(--teal); bottom: 24px; right: 8%; animation: melayang 6s ease-in-out -2s infinite; }
  .blob--3 { width: 38px; height: 38px; background: var(--sage); bottom: -14px; left: 40%; animation: melayang 8s ease-in-out -4s infinite; }

  /* uap kopi */
  .uap path {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    opacity: 0;
    animation: uap 3s ease-in-out infinite;
  }
  .uap__2 { animation-delay: 0.6s; }
  .uap__3 { animation-delay: 1.2s; }

  /* ---------- Muncul saat load ---------- */
  .anim {
    animation: naik 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i, 0) * 120ms);
  }
  .anim--pop {
    animation-name: pop, ambang;
    animation-duration: 0.7s, 4s;
    animation-delay: calc(var(--i, 0) * 120ms), 0.8s;
    animation-iteration-count: 1, infinite;
    animation-timing-function: cubic-bezier(0.2, 0.9, 0.3, 1.3), ease-in-out;
  }

  .denyut {
    animation: naik 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both, denyut 2.4s ease-in-out 1.5s infinite;
    animation-delay: calc(var(--i, 0) * 120ms), 1.5s;
  }

  /* ---------- Muncul saat scroll ---------- */
  :global(.js) .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i, 0) * 120ms);
  }
  :global(.js) .reveal.terlihat {
    opacity: 1;
    transform: none;
  }

  /* ---------- Kartu ---------- */
  .judul {
    margin: 0 0 16px;
    font-size: 24px;
    font-weight: 800;
  }
  .grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .kartu {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0;
  }
  .kartu.terlihat:hover {
    transform: translate(-3px, -4px);
    box-shadow: 7px 8px 0 0 var(--ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    transition-delay: 0s;
  }
  .kartu__bungkus {
    overflow: hidden;
    border-bottom: var(--border);
  }
  .kartu__foto {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .kartu:hover .kartu__foto {
    transform: scale(1.07) rotate(-1deg);
  }
  .kartu__isi {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
  }
  .kartu__isi h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
  }
  .deskripsi {
    margin: 0;
    font-size: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    margin: auto 0 4px;
  }
  .footer {
    border-top: var(--border);
    padding-top: 20px;
    padding-bottom: 32px;
  }
  .footer p {
    margin: 0;
  }

  /* ---------- Keyframes ---------- */
  @keyframes naik {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes pop {
    from { opacity: 0; transform: scale(0.6) rotate(-8deg); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes ambang {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }
  @keyframes melayang {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(10px, -14px); }
  }
  @keyframes uap {
    0%   { stroke-dashoffset: 60; opacity: 0; transform: translateY(8px); }
    40%  { opacity: 0.9; }
    100% { stroke-dashoffset: 0; opacity: 0; transform: translateY(-10px); }
  }
  @keyframes denyut {
    0%, 100% { box-shadow: var(--shadow-action); }
    50%      { box-shadow: 0 0 0 6px rgba(31, 27, 22, 0.18), var(--shadow-action); }
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 28px 20px;
    }
    .hero__cangkir {
      max-width: 200px;
    }
  }

  /* Hormati pengguna yang mematikan animasi */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
    }
    :global(.js) .reveal {
      opacity: 1;
      transform: none;
    }
    .uap path {
      opacity: 0.8;
      stroke-dashoffset: 0;
    }
  }
</style>